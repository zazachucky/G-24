# Connect a dedicated Upstash Redis database from Vercel Storage.
# KV_REST_API_URL / KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional override. Defaults isolate production, development, and each preview.
# GS_STATE_KEY=gs-ai-live:g-24:production:v1
