{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    { "source": "/app/customer.html", "destination": "/mobile.html", "permanent": false },
    { "source": "/app/director.html", "destination": "/director.html", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/health", "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }] }
  ]
}
